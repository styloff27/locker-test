<h1>Lockers</h1>

<% if @lockers.any? %>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Location</th>
        <th>State</th>
        <% if Current.user.support_engineer? %>
          <th>Tenant</th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @lockers.each do |locker| %>
        <tr>
          <td><%= locker.name %></td>
          <td><%= locker.location %></td>
          <td><%= locker.state.humanize %></td>
          <% if Current.user.support_engineer? %>
            <td><%= locker.tenant.name %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No lockers to show.</p>
<% end %>
