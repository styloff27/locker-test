<% content_for :title, @locker.name %>

<h1><%= @locker.name %></h1>

<dl>
  <dt>Location</dt>
  <dd><%= @locker.location %></dd>
  <dt>State</dt>
  <dd><%= @locker.state.humanize %></dd>
  <dt>Tenant</dt>
  <dd><%= @locker.tenant.name %></dd>
  <dt>Teams</dt>
  <dd><%= @locker.teams.order(:name).pluck(:name).join(", ").presence || "None" %></dd>
</dl>
