<% content_for :title, @locker.name %>

<h1><%= @locker.name %></h1>

<dl>
  <dt>Location</dt>
  <dd><%= @locker.location %></dd>
  <dt>State</dt>
  <dd><%= @locker.state.humanize %></dd>
  <dt>Tenant</dt>
  <dd><%= @locker.tenant.name %></dd>
  <dt>Teams</dt>
  <dd><%= @team_names.join(", ").presence || "None" %></dd>
</dl>

<%= render "locker_actions/button", locker: @locker %>

<h2>History</h2>

<%= render "locker_actions/log", locker_actions: @locker_actions, pagy: @pagy %>
